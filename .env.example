# Backend Configuration (e.g. on Render)
PORT=8000
HOST=0.0.0.0
# Set CORS_ORIGINS to your deployed Vercel domain in production, comma-separated
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Frontend Configuration (e.g. on Vercel)
# Set VITE_API_BASE_URL to your deployed Render service URL
VITE_API_BASE_URL=https://your-service.onrender.com
